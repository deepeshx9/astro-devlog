---
import { getCollection } from 'astro:content';
import '../styles/global.css';

// Fetch all markdown files and sort them by date (newest first)
const allLogs = await getCollection('devlog');
const sortedLogs = allLogs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terminal // deepesh.info</title>
    <script is:inline src="https://platform.linkedin.com/badges/js/profile.js" async defer></script>
  </head>
  <body class="bg-slate-950 text-cyan-400 min-h-screen flex items-center justify-center p-4 font-mono select-none selection:bg-cyan-500 selection:text-slate-950">

    <!-- LinkedIn's embedded profile badge (photo, name, headline) — desktop/tablet only,
         since the iframe is ~300px wide and would cover the devlog card on phones -->
    <div class="fixed top-2 left-2 z-10 hidden sm:block">
      <div
        class="badge-base LI-profile-badge"
        data-locale="en_US"
        data-size="medium"
        data-theme="dark"
        data-type="VERTICAL"
        data-vanity="deepeshx9"
        data-version="v1"
      >
        <a
          class="badge-base__link LI-simple-link text-cyan-400 hover:text-white text-xs tracking-wider"
          href="https://www.linkedin.com/in/deepeshx9?trk=profile-badge"
        >in/deepeshx9</a>
      </div>
    </div>

    <!-- Compact fallback link for small screens -->
    <a
      href="https://www.linkedin.com/in/deepeshx9"
      target="_blank"
      rel="noopener noreferrer"
      data-augmented-ui="tl-clip br-clip both"
      class="fixed top-2 left-2 z-10 flex sm:hidden items-center gap-2 bg-slate-900/80 border border-cyan-500/40 px-3 py-2 backdrop-blur-md transition-all duration-300 hover:border-cyan-400 group"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" class="w-4 h-4 fill-cyan-500 group-hover:fill-cyan-300 transition-colors shrink-0">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
      </svg>
      <span class="text-xs font-bold tracking-wider text-cyan-400 group-hover:text-white transition-colors">in/deepeshx9</span>
    </a>

    <main 
      data-augmented-ui="tl-clip br-clip tr-2-clip-x both" 
      class="bg-slate-900/80 border border-cyan-500/40 p-8 max-w-2xl w-full backdrop-blur-md shadow-[0_0_30px_rgba(6,182,212,0.15)] transition-all duration-300 hover:border-cyan-400"
    >
      <header class="border-b border-cyan-900/60 pb-4 mb-6 flex justify-between items-start">
        <div>
          <h1 class="text-2xl font-black tracking-widest uppercase drop-shadow-[0_0_10px_rgba(34,211,238,0.5)]">
            SYS_INIT // ONLINE
          </h1>
          <p class="text-[10px] text-cyan-600 font-bold tracking-wider mt-1">NODE_ENV // WSL_UBUNTU_X64</p>
        </div>
      </header>

      <section class="text-slate-300 space-y-4 text-sm leading-relaxed mb-8">
        <p class="border-l-2 border-cyan-500 pl-3 bg-cyan-950/20 py-1 text-cyan-300">
          Neural link established. Awaiting command input...
        </p>
      </section>

      <section>
        <h2 class="text-[11px] text-slate-500 border-b border-slate-800 pb-1 mb-3 uppercase tracking-widest">Available Transmissions</h2>
        <ul class="space-y-2">
          {sortedLogs.map((log) => (
            <li class="flex items-center gap-4 group">
              <span class="text-cyan-800 text-xs">[{log.data.date.toISOString().split('T')[0]}]</span>
                  <a href={`/log/${log.id}`} class="text-cyan-400 hover:text-white hover:bg-cyan-900 px-2 py-1 transition-colors block w-full border-l border-transparent group-hover:border-cyan-400">
  >                {log.data.title}
                  </a>
            </li>
          ))}
        </ul>
      </section>

    </main>

  </body>
</html>