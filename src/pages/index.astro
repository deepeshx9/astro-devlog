---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terminal // Devlog</title>
  </head>
  <body class="bg-slate-950 text-cyan-400 min-h-screen flex items-center justify-center p-4 font-mono select-none selection:bg-cyan-500 selection:text-slate-950">
    
    <main 
      data-augmented-ui="tl-clip br-clip tr-2-clip-x both" 
      class="bg-slate-900/80 border border-cyan-500/40 p-8 max-w-2xl w-full backdrop-blur-md shadow-[0_0_30px_rgba(6,182,212,0.15)] transition-all duration-300 hover:border-cyan-400"
    >
      <header class="border-b border-cyan-900/60 pb-4 mb-6 flex justify-between items-start">
        <div>
          <h1 class="text-2xl font-black tracking-widest uppercase drop-shadow-[0_0_10px_rgba(34,211,238,0.5)]">
            SYS_INIT // ONLINE
          </h1>
          <p class="text-[10px] text-cyan-600 font-bold tracking-wider mt-1">NODE_ENV // WSL_UBUNTU_X64</p>
        </div>
        <div class="text-right text-[10px] text-slate-500">
          <p>LOC: 127.0.0.1</p>
          <p>PORT: 4321</p>
        </div>
      </header>

      <section class="text-slate-300 space-y-4 text-sm leading-relaxed">
        <p class="border-l-2 border-cyan-500 pl-3 bg-cyan-950/20 py-1 text-cyan-300">
          Static asset pipeline connected. Tailwind utility layers mapped successfully.
        </p>
        <p class="text-slate-400">
          This terminal layout forms the baseline container for the devlog engine. Future entries will stream markdown files natively into this container via internal routing collections.
        </p>
      </section>

      <footer class="mt-8 pt-4 border-t border-slate-800 flex justify-between items-center text-[11px] text-slate-500">
        <span class="flex items-center gap-2">
          <span class="w-2 height-2 rounded-full bg-cyan-500 animate-pulse"></span>
          AWAITING_INPUT
        </span>
        <span>v1.0.0</span>
      </footer>
    </main>

  </body>
</html>