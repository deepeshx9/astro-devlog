---
// 1. Import the standalone render function
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const logEntries = await getCollection('devlog');
  return logEntries.map(entry => ({
    // 2. Map to entry.id instead of entry.slug
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// 3. Use the new render API
const { Content } = await render(entry);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{entry.data.title} // deepesh.info</title>
  </head>
  <body class="bg-slate-950 text-cyan-400 min-h-screen flex items-center justify-center p-4 font-mono select-none selection:bg-cyan-500 selection:text-slate-950">
    
    <main 
      data-augmented-ui="tl-clip br-clip tr-2-clip-x both" 
      class="bg-slate-900/80 border border-cyan-500/40 p-8 max-w-3xl w-full backdrop-blur-md shadow-[0_0_30px_rgba(6,182,212,0.15)]"
    >
      <header class="border-b border-cyan-900/60 pb-4 mb-6">
        <div class="flex justify-between items-start">
          <h1 class="text-xl font-black tracking-widest text-white">
            {entry.data.title}
          </h1>
          <a href="/" class="text-[10px] bg-cyan-950 text-cyan-400 px-2 py-1 border border-cyan-800 hover:bg-cyan-900">[ RETURN_TO_ROOT ]</a>
        </div>
        <div class="flex gap-4 text-[10px] text-cyan-600 font-bold tracking-wider mt-2">
          <span>DATE: {entry.data.date.toISOString().split('T')[0]}</span>
          <span>STATUS: {entry.data.status}</span>
        </div>
      </header>

      <article class="text-slate-300 space-y-4 text-sm leading-relaxed [&>h3]:text-cyan-300 [&>h3]:font-bold [&>h3]:mt-6 [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:text-slate-400 [&>table]:w-full [&>table]:text-left [&>table]:border-collapse [&_th]:border-b [&_th]:border-cyan-800 [&_th]:pb-2 [&_th]:text-cyan-500 [&_td]:py-2 [&_td]:border-b [&_td]:border-slate-800/50">
        <Content />
      </article>

    </main>
  </body>
</html>